# ===================================================================
# DEV-ONLY LOCAL DEFAULTS. Not the Connection Panel.
#
# `.env.example` is the one guarded connection panel and does not change. This file is a
# ready-to-copy set of the local Compose values, and nothing more:
#
#   Copy-Item .env.local.example .env      (PowerShell)
#   cp .env.local.example .env             (POSIX)
#
# Every value below is a dev placeholder for a loopback-only local stack. Nothing real may ever
# be added here: this file IS tracked by git. Put real values in `.env`, which is git-ignored.
#
# You do NOT need this for `docker compose up` — docker-compose.yml carries the same defaults.
# Copy it only when you run `pnpm start:gateway`, `pnpm start:simulator` or `pnpm dev:admin`,
# which read the root `.env` instead.
#
# The two service-name hosts (`emqx`, `gateway`) are Compose service names, so they resolve on
# the Compose network only. For `pnpm start:gateway` / `pnpm start:simulator` outside Compose,
# change them to 127.0.0.1.
# ===================================================================

# --- Device seam ---
MQTT_BROKER_URL=mqtt://emqx:1883
# Empty on purpose. Anonymous broker access is OFF, and these are the SIMULATOR's values: a
# null broker credential is what makes it authenticate as the device, with DEVICE_ID and
# DEVICE_TOKEN - exactly what firmware does. Local_Mode maps unset or empty to null. The
# gateway authenticates as the cloud instead, and carries its own credential in
# docker-compose.yml so that one leaked token cannot impersonate the other.
MQTT_USERNAME=
MQTT_PASSWORD=
AUDIO_WSS_URL=ws://gateway:8081

# --- Device identity (the single registered dev device) ---
DEVICE_ID=prt_000123
DEVICE_TOKEN=dev_local_only_not_a_secret

# --- Environment ---
APP_ENV=local

# --- Device-facing bind ---
# 127.0.0.1 keeps the stack closed. Set 0.0.0.0 ONLY to let a physical device on your LAN
# reach the broker and the audio socket; it never opens the console or the panel.
DEVICE_BIND_HOST=127.0.0.1

# --- Local control surfaces ---
GATEWAY_OPERATOR_PORT=8090
SIMULATOR_PANEL_PORT=8091
